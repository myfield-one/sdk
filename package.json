{
  "name": "@myfield/sdk",
  "version": "0.9.1",
  "description": "Myfield open SDK: instance auth and end-to-end-encrypted bucket sync for third-party web apps.",
  "license": "Apache-2.0",
  "author": "OPENTECH AI PTE. LTD.",
  "homepage": "https://github.com/myfield-one/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myfield-one/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/myfield-one/sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "types/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "myfield",
    "local-first",
    "encrypted-sync",
    "sdk"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.5.4"
  }
}
